---
import { cover, kindLabel, tempoRelativo, type Lancamento } from "../lib/api";
interface Props { itens: Lancamento[]; }
const { itens } = Astro.props;
const linhas: Lancamento[] = itens.slice(0, 12);
---
<section class="releases-section">
  <div class="releases-header">
    <div>
      <h2 class="releases-title">Lançamentos recentes</h2>
      <p class="releases-subtitle">Capítulos publicados nas últimas horas</p>
    </div>
    <div class="header-right-tools"><a class="view-all-link" href="/lancamentos">ver todos</a></div>
  </div>
  {linhas.length === 0 ? (
    <p class="empty-releases">Nenhum lançamento recente.</p>
  ) : (
    <div class="releases-grid">
      {linhas.map((c) => (
        <div class="release-row-card">
          <div class="release-top-row">
            {c.kind && <span class="kind-tag">{kindLabel(c.kind)}</span>}
            <span class="timestamp-box">{tempoRelativo(c.published_at)}</span>
          </div>
          <div class="release-main">
            <a class="cover-thumb-link" href={`/obra/${c.obra_slug ?? ""}`}>
              <img class="thumb-img" src={cover(c.cover_id)} alt={c.obra_titulo ?? ""} loading="lazy" width="56" height="78" />
            </a>
            <div class="release-info">
              <a class="work-link" href={`/obra/${c.obra_slug ?? ""}`}>{c.obra_titulo}</a>
              <div class="chapter-pills-row">
                <a class="chapter-pill latest-pill" href={`/ler/${c.id}`}>
                  <span class="pill-dot"></span>
                  <span class="ch-text">cap. {c.display_number ?? c.number}</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</section>
<style is:global>
.releases-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.15rem;width:100%}
@media (max-width:900px){.releases-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.releases-grid{grid-template-columns:1fr}}
</style>
