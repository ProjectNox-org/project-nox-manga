---
interface Props { idade?: number | string | null }
const { idade } = Astro.props;
const bloqueado = Number(idade ?? 0) >= 18;
---
{bloqueado && (
  <div id="age-gate" class="age-gate" hidden>
    <div class="age-gate-box" role="dialog" aria-modal="true" aria-labelledby="age-title">
      <h2 id="age-title" class="age-gate-title">Conteúdo para maiores de 18 anos</h2>
      <p class="age-gate-text">Esta obra contém conteúdo adulto. Confirme sua idade para continuar.</p>
      <div class="age-gate-actions">
        <button id="age-yes" class="btn-primary-hero" type="button">Tenho 18 anos ou mais</button>
        <a href="/catalogo" class="btn-secondary-hero">Voltar ao catálogo</a>
      </div>
    </div>
  </div>
)}
<script is:inline>
  (() => {
    const gate = document.getElementById('age-gate');
    if (!gate) return;
    if (localStorage.getItem('nox-age-ok') !== '1') { gate.hidden = false; document.body.style.overflow = 'hidden'; }
    document.getElementById('age-yes')?.addEventListener('click', () => {
      localStorage.setItem('nox-age-ok', '1'); gate.hidden = true; document.body.style.overflow = '';
    });
  })();
</script>
<style>
  .age-gate { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; background: rgba(3,3,6,.86); backdrop-filter: blur(6px); padding: 1rem; }
  .age-gate[hidden] { display: none; }
  .age-gate-box { max-width: 420px; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
  .age-gate-title { margin: 0 0 .5rem; font-size: 1.1rem; color: var(--gold); }
  .age-gate-text { margin: 0 0 1rem; color: var(--muted); font-size: .92rem; }
  .age-gate-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
</style>
