---
interface Props { path?: string }
const { path = "/" } = Astro.props;
const links = [
  { href: "/", label: "Início" },
  { href: "/catalogo", label: "Catálogo" },
  { href: "/ranking", label: "Ranking" },
  { href: "/scans", label: "Scans" },
  { href: "/loja", label: "Loja" },
];
const isAt = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Project Nox, início">
      <div class="brand-symbol-wrap">
        <img src="/brand/nox-symbol-128.webp?v=3" alt="Project Nox" width="46" height="46" class="header-symbol" />
        <span class="brand-symbol-glow"></span>
      </div>
      <span class="brand-text">
        <span class="brand-project">PROJECT</span>
        <span class="brand-nox">NOX</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {links.map((l) => (
        <a href={l.href} class={isAt(l.href) ? "active" : ""}><span>{l.label}</span></a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="icon-button header-search-btn" href="/catalogo" aria-label="Pesquisar catálogo">⌕</a>
      <a class="btn-login-nav" href="/entrar">Entrar</a>
    </div>
  </div>
</header>
<nav class="mobile-bottom" aria-label="Navegação Principal">
  {links.map((l) => (
    <a href={l.href} class={isAt(l.href) ? "active" : ""}><span>{l.label}</span></a>
  ))}
</nav>
