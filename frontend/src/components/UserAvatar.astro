---
interface Props { nome?: string | null; avatarId?: string | null; tamanho?: number; classe?: string }
const { nome = '?', avatarId = null, tamanho = 40, classe = '' } = Astro.props;
const inicial = (nome ?? '?').trim().charAt(0).toUpperCase() || '?';
---
<span class={`ua ${classe}`} style={`--ua:${tamanho}px`}>
  {avatarId ? (
    <img class="ua-img" src={`/midia/${avatarId}`} alt={nome ?? ''} width={tamanho} height={tamanho} loading="lazy" onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='grid')" />
  ) : null}
  <span class="ua-fallback" style={avatarId ? 'display:none' : ''} aria-hidden="true">{inicial}</span>
</span>
<style>
  .ua { width: var(--ua); height: var(--ua); border-radius: 50%; overflow: hidden; display: inline-grid; place-items: center; background: var(--bg-surface); border: 1px solid var(--line); flex: 0 0 auto; }
  .ua-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ua-fallback { display: grid; place-items: center; width: 100%; height: 100%; font-weight: 700; color: var(--purple); font-size: calc(var(--ua) * .42); }
</style>
