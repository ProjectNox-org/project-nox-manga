---
interface Props{ secao:string; titulo:string }
const { secao, titulo } = Astro.props;
const API = import.meta.env.NOX_API ?? 'http://127.0.0.1:3000';
const cookie = Astro.request.headers.get('cookie') ?? '';
let j:any=null, status=0;
try{ const r=await fetch(`${API}/api/admin/secao/${secao}`,{headers:cookie?{cookie}:{}}); status=r.status; j=await r.json().catch(()=>null); }catch{}
const linhas:any[] = Array.isArray(j?.itens)?j.itens:(Array.isArray(j?.dados)?j.dados:(Array.isArray(j?.rows)?j.rows:[]));
const chaves = linhas.length ? Object.keys(linhas[0]) : [];
---
<section class="collection-header"><h1 class="releases-title">{titulo}</h1>
<p class="releases-subtitle">admin / {secao}</p></section>
<div class="tabela-wrap">
{status===403 && <div class="auth-alert">Sem permissão para esta seção.</div>}
{status===401 && <div class="auth-alert">Faça login novamente.</div>}
{status===200 && linhas.length>0 && (
 <table><thead><tr>{chaves.map(k=><th>{k}</th>)}</tr></thead>
 <tbody>{linhas.map(l=>(<tr>{chaves.map(k=><td>{String(l[k] ?? '—')}</td>)}</tr>))}</tbody></table>)}
{status===200 && linhas.length===0 && <div class="empty-releases">Sem registros.</div>}
</div>