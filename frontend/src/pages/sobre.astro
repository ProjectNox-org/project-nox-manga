---
import Base from '../layouts/Base.astro';
---
<Base title="Sobre">
  <div class="container spacer-bottom">
    <section class="collection-header"><h1 class="collection-title">Sobre o Project Nox</h1><p class="collection-sub">Leitura de mangás, manhwas e manhuas com foco em experiência e comunidade.</p></section>
    <div class="continue-grid">
      <article class="continue-card"><h2 class="edit-card-title">Nossa proposta</h2><p class="edit-card-sub">Catálogo amplo, leitor rápido e progresso sincronizado entre dispositivos.</p></article>
      <article class="continue-card"><h2 class="edit-card-title">Comunidade</h2><p class="edit-card-sub">Avaliações, comentários e rankings construídos pelos leitores.</p></article>
    </div>
  </div>
</Base>
