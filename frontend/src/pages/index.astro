---
import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import WorkShelf from "../components/WorkShelf.astro";
import RecentReleases from "../components/RecentReleases.astro";
import { homeData } from "../lib/api";
const { obras, novasObras, recentes } = await homeData();
---
<Base title="Project Nox">
  <div class="home-wrapper">
    <HeroCarousel obras={obras.slice(0, 5)} />
    <div class="home-content">
      <WorkShelf titulo="Novas Obras" subtitulo="Adicionadas recentemente ao catálogo" obras={novasObras} verTudo="/catalogo?sort=recentes" />
      <WorkShelf titulo="Mais Lidos" subtitulo="As obras mais acessadas da plataforma" obras={obras} verTudo="/catalogo?sort=populares" />
      <RecentReleases itens={recentes} />
    </div>
  </div>
</Base>
